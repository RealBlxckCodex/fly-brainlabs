<!-- Simplified Drosophila body in CGS units (cm, g, s), same unit system as flybody.
     ~2.5 mm long, ~1 mg. Body segments are fluid ellipsoids (MuJoCo fluid model),
     legs are rigid skids, wings are visual only (aerodynamics are abstracted as a
     thrust/torque primitive, see fly.py). -->
<mujoco model="simple_fly">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.0001" gravity="0 0 -981" density="0.00128" viscosity="0.000185" integrator="implicitfast"/>
  <default>
    <geom contype="0" conaffinity="0" rgba="0.55 0.35 0.2 1"/>
    <default class="leg">
      <geom type="capsule" size="0.006" mass="0.000005" rgba="0.35 0.2 0.1 1"/>
    </default>
    <default class="foot">
      <geom type="sphere" size="0.01" mass="0.000002" contype="1" conaffinity="1" friction="0.02 0.001 0.0001" rgba="0.2 0.1 0.05 1"/>
    </default>
  </default>
  <worldbody>
    <body name="thorax" pos="0 0 0.075">
      <freejoint name="free"/>
      <site name="thorax" size="0.01"/>
      <geom name="thorax" type="ellipsoid" size="0.05 0.042 0.045" mass="0.00040" fluidshape="ellipsoid"/>
      <geom name="head" type="ellipsoid" pos="0.075 0 0.012" size="0.028 0.042 0.035" mass="0.00013" fluidshape="ellipsoid" rgba="0.6 0.1 0.1 1"/>
      <geom name="abdomen" type="ellipsoid" pos="-0.095 0 -0.008" size="0.07 0.04 0.036" mass="0.00040" fluidshape="ellipsoid"/>
      <geom name="wing_left" type="ellipsoid" pos="-0.06 0.06 0.045" size="0.11 0.04 0.001" euler="0 0 0.25" mass="0.000002" rgba="0.8 0.85 0.95 0.4" group="1"/>
      <geom name="wing_right" type="ellipsoid" pos="-0.06 -0.06 0.045" size="0.11 0.04 0.001" euler="0 0 -0.25" mass="0.000002" rgba="0.8 0.85 0.95 0.4" group="1"/>
      <site name="eye_left" pos="0.085 0.03 0.02" size="0.005"/>
      <site name="eye_right" pos="0.085 -0.03 0.02" size="0.005"/>
      <site name="antenna_left" pos="0.1 0.012 0.03" size="0.004"/>
      <site name="antenna_right" pos="0.1 -0.012 0.03" size="0.004"/>
      <geom class="leg" fromto="0.03 0.03 -0.02 0.10 0.10 -0.065"/>
      <geom class="leg" fromto="0.00 0.035 -0.02 0.00 0.13 -0.065"/>
      <geom class="leg" fromto="-0.03 0.03 -0.02 -0.11 0.11 -0.065"/>
      <geom class="leg" fromto="0.03 -0.03 -0.02 0.10 -0.10 -0.065"/>
      <geom class="leg" fromto="0.00 -0.035 -0.02 0.00 -0.13 -0.065"/>
      <geom class="leg" fromto="-0.03 -0.03 -0.02 -0.11 -0.11 -0.065"/>
      <geom class="foot" name="foot_T1_left" pos="0.10 0.10 -0.065"/>
      <geom class="foot" name="foot_T2_left" pos="0.00 0.13 -0.065"/>
      <geom class="foot" name="foot_T3_left" pos="-0.11 0.11 -0.065"/>
      <geom class="foot" name="foot_T1_right" pos="0.10 -0.10 -0.065"/>
      <geom class="foot" name="foot_T2_right" pos="0.00 -0.13 -0.065"/>
      <geom class="foot" name="foot_T3_right" pos="-0.11 -0.11 -0.065"/>
    </body>
  </worldbody>
</mujoco>
